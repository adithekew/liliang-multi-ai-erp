# Demo-only environment file; never commit real credentials
APP_ENV=pilot
# Optional: set DATABASE_URL to the full Neon PostgreSQL URI in Render Environment
# DATABASE_URL=postgresql://<db_user>:<password>@<hostname>/<database>?sslmode=require
DATABASE_PATH=./liliang-local.db
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-unique-strong-password
SECRET_KEY=replace-with-at-least-32-random-characters
